// Package {{.Snake}} implements the {{.Snake}} API and its business rules.
package {{.Snake}}

import (
	"errors"
	"strings"
	"unicode/utf8"
)

// Input is the transport-independent data needed to create or replace a {{.Snake}}.
type Input struct {
	Name string
}

func (in Input) Validate() error {
	if strings.TrimSpace(in.Name) == "" || utf8.RuneCountInString(in.Name) > 200 {
		return ErrInvalidInput
	}
	return nil
}

var (
	ErrNotFound     = errors.New("{{.Snake}} not found")
	ErrForbidden    = errors.New("forbidden")
	ErrInvalidInput = errors.New("name must contain 1 to 200 characters")
)
