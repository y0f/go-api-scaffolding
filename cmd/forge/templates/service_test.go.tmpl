package {{.Snake}}

import (
	"context"
	"errors"
	"strings"
	"testing"

	"github.com/google/uuid"

	"{{.Module}}/internal/auth"
	db "{{.Module}}/internal/gen/db"
)

type fakeRepo struct {
	createCalled bool
	last         db.{{.Pascal}}
}

func (f *fakeRepo) Create(_ context.Context, in Input) (db.{{.Pascal}}, error) {
	f.createCalled = true
	f.last = db.{{.Pascal}}{ID: uuid.New(), Name: in.Name}
	return f.last, nil
}

func (f *fakeRepo) Get(_ context.Context, _ uuid.UUID) (db.{{.Pascal}}, error) {
	return f.last, nil
}

func (f *fakeRepo) List(_ context.Context, _, _ int32) ([]db.{{.Pascal}}, int64, error) {
	return []db.{{.Pascal}}{f.last}, 1, nil
}

func (f *fakeRepo) Delete(_ context.Context, _ uuid.UUID) error { return nil }

func TestServiceCreateRequiresPermission(t *testing.T) {
	repo := &fakeRepo{}
	svc := NewService(repo)
	if _, err := svc.Create(context.Background(), auth.Principal{}, Input{Name: "example"}); !errors.Is(err, ErrForbidden) {
		t.Fatalf("got %v, want ErrForbidden", err)
	}
	if repo.createCalled {
		t.Error("repository Create should not run without permission")
	}
}

func TestServiceCreateAllowsAuthorized(t *testing.T) {
	svc := NewService(&fakeRepo{})
	actor := auth.Principal{Scopes: []string{PermissionWrite}}
	got, err := svc.Create(context.Background(), actor, Input{Name: "example"})
	if err != nil {
		t.Fatalf("create: %v", err)
	}
	if got.Name != "example" {
		t.Fatalf("got name %q, want %q", got.Name, "example")
	}
}

func (f *fakeRepo) Update(_ context.Context, id uuid.UUID, in Input) (db.{{.Pascal}}, error) {
	f.last = db.{{.Pascal}}{ID: id, Name: in.Name}
	return f.last, nil
}

func TestServiceMutationsRequirePermission(t *testing.T) {
	repo := &fakeRepo{}
	svc := NewService(repo)
	if _, err := svc.Update(context.Background(), auth.Principal{}, uuid.New(), Input{Name: "changed"}); !errors.Is(err, ErrForbidden) {
		t.Fatalf("update: %v", err)
	}
	if err := svc.Delete(context.Background(), auth.Principal{}, uuid.New()); !errors.Is(err, ErrForbidden) {
		t.Fatalf("delete: %v", err)
	}
	if repo.last.Name != "" {
		t.Fatal("unauthorized update reached repository")
	}
}

func TestServiceRejectsInvalidNames(t *testing.T) {
	svc := NewService(&fakeRepo{})
	actor := auth.Principal{Scopes: []string{PermissionWrite}}
	for _, name := range []string{"", "   ", strings.Repeat("a", 201)} {
		if _, err := svc.Create(context.Background(), actor, Input{Name: name}); !errors.Is(err, ErrInvalidInput) {
			t.Errorf("name length %d: %v", len(name), err)
		}
	}
}
