package {{.Snake}}

import (
	"context"

	"github.com/google/uuid"

	"{{.Module}}/internal/auth"
	db "{{.Module}}/internal/gen/db"
)

// PermissionWrite is required to create, replace, or delete a {{.Snake}}. Grant
// it to roles in internal/auth/principal.go, or issue tokens carrying it as a
// scope.
const PermissionWrite = "{{.Table}}:write"

// Service holds the business rules for {{.Snake}}, including authorization. It
// depends on the Repository interface, so it is unit-testable without a
// database.
type Service struct {
	repo Repository
}

func NewService(repo Repository) *Service {
	return &Service{repo: repo}
}

func (s *Service) Create(ctx context.Context, actor auth.Principal, in Input) (db.{{.Pascal}}, error) {
	if err := s.authorizeWrite(actor); err != nil {
		return db.{{.Pascal}}{}, err
	}
	if err := in.Validate(); err != nil {
		return db.{{.Pascal}}{}, err
	}
	return s.repo.Create(ctx, in)
}

func (s *Service) Get(ctx context.Context, id uuid.UUID) (db.{{.Pascal}}, error) {
	return s.repo.Get(ctx, id)
}

func (s *Service) List(ctx context.Context, limit, offset int32) ([]db.{{.Pascal}}, int64, error) {
	return s.repo.List(ctx, limit, offset)
}

func (s *Service) Delete(ctx context.Context, actor auth.Principal, id uuid.UUID) error {
	if err := s.authorizeWrite(actor); err != nil {
		return err
	}
	return s.repo.Delete(ctx, id)
}

func (s *Service) Update(ctx context.Context, actor auth.Principal, id uuid.UUID, in Input) (db.{{.Pascal}}, error) {
	if err := s.authorizeWrite(actor); err != nil {
		return db.{{.Pascal}}{}, err
	}
	if err := in.Validate(); err != nil {
		return db.{{.Pascal}}{}, err
	}
	return s.repo.Update(ctx, id, in)
}

func (*Service) authorizeWrite(actor auth.Principal) error {
	if !actor.HasPermission(PermissionWrite) {
		return ErrForbidden
	}
	return nil
}
